/* ===== RESET & ROOT VARIABLES ===== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Montserrat', "Segoe UI", sans-serif;
}

:root {
    --bg-dark: #0a0a0a;
    --card-bg: #161616;
    --text-main: #ffffff;
    --text-dim: #a0a0a0;
    --accent: #007bff; /* Primary blue */
}

/* ===== BODY ===== */
body {
    background-color: var(--bg-dark);
    color: var(--text-main);
    line-height: 1.6;
}

/* ===== MAIN CONTAINER ===== */
.container {
    display: grid;
    grid-template-columns: 35% 65%;
    min-height: 100vh;
}

/* ===== GLASSMORPHISM HEADER EFFECT ===== */
#about-title {
    /* 1. Stick to the top during scroll */
    position: sticky;
    top: 0;
    z-index: 100;
    
    /* 2. Transparency and Blur */
    background: rgba(10, 10, 10, 0.65); /* Dark background with 65% opacity */
    backdrop-filter: blur(12px);         /* This creates the frosted glass look */
    -webkit-backdrop-filter: blur(12px); /* Support for Safari */
    
    /* 3. Styling and Spacing */
    padding: 20px 0;
    margin-top: 0;
    margin-bottom: 25px;
    
    /* 4. Subtle Border to define the edge */
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    
    /* 5. Text styling to pop against the blur */
    color: var(--text-main);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;

    font-size: 28px;
    margin-bottom: 20px;
    color: var(--text-main);
    border-left: 4px solid var(--accent);
    padding-left: 15px;
}

/* ===== LEFT IMAGE SECTION ===== */
.photo {
    position: fixed;
    left: 0;
    top: 0;
    width: 35%;
    height: 100vh;
    z-index: 10;
}

.photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(40%) brightness(0.8);
    transition: filter 0.5s ease;
}

.photo:hover img {
    filter: grayscale(0%) brightness(1);
}

/* ===== RIGHT CONTENT SCROLLING ===== */
.user-card, .self-card, .contact-section {
    grid-column: 2;
    padding: 60px 80px;
    background-color: var(--bg-dark);
}

/* ===== NAME & HERO ===== */
.user-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 80vh;
    margin-top: 50px
}

#main-name {
    font-size: clamp(40px, 8vw, 80px); /* Adjusts size based on screen */
    font-weight: 800;
    text-transform: uppercase;
    margin-bottom: 5px;
    
    /* Gradient Background */
    background: linear-gradient(
        to right, 
        #ffffff 20%, 
        #007bff 40%, 
        #007bff 60%, 
        #ffffff 80%
    );
    background-size: 200% auto;
    
    /* Clip text to background */
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;

    
    /* Animation Setup */
    display: block;
    width: fit-content;
    overflow: hidden; 
    white-space: nowrap; 
    border-right: 4px solid var(--accent);
    
    /* Animation 1: typing - handle the width
       Animation 2: blink - handle the cursor
    */
    animation: 
        continuousTyping 6s steps(13, end) infinite,
        blink 0.8s step-end infinite;
}

/* Logic for Continuous Type -> Pause -> Delete -> Repeat */
@keyframes continuousTyping {
    0%, 10% { width: 0; }             /* Start empty */
    40%, 60% { width: 100%; }         /* Fully typed (pauses here) */
    90%, 100% { width: 0; }           /* Deletes and restarts */
}

/* Cursor Blink Logic */
@keyframes blink {
    from, to { border-color: transparent; }
    50% { border-color: var(--accent); }
}


#passion {
    font-size: 20px;
    color: var(--accent);
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 30px;
}

.check-it-btn{
    display: inline-block;
    width: max-content;
    margin-top: 24px;
    padding: 10px 15px;
    border: 2px solid var(--text-main);
    color: var(--text-main);
    text-decoration: none;
    font-weight: 550;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: 0.4s;
}

.btn-download {
    display: inline-block;
    width: max-content;
    padding: 15px 35px;
    border: 2px solid var(--text-main);
    color: var(--text-main);
    text-decoration: none;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: 0.4s;
}

.btn-download:hover, .check-it-btn:hover {
    background-color: var(--text-main);
    color: #000;
    transform: translateY(-3px);
}

/* ===== CARD STYLING FOR SECTIONS ===== */
.main-project{
    background: var(--card-bg);
    /* padding: 40px; */
    margin-top: 20px;
    padding-left: 40px;
    padding-right: 40px;
    padding-bottom: 40px;
    border-radius: 12px;
    margin-bottom: 30px;
    border: 1px solid #222;
    transition: transform 0.3s ease, border-color 0.3s ease;
}

.about, .skils, .projects,.other-hobbies{
    background: var(--card-bg);
    padding: 40px;
    border-radius: 12px;
    margin-bottom: 30px;
    border: 1px solid #222;
    transition: transform 0.3s ease, border-color 0.3s ease;
}

.about:hover, .skils:hover, .projects:hover, .main-project:hover,.other-hobbies{
    border-color: #444;
    transform: translateY(-5px);
}

/* #about-title { */
    /* font-size: 28px;
    margin-bottom: 20px;
    color: var(--text-main);
    border-left: 4px solid var(--accent);
    padding-left: 15px; */
/* } */

#ab {
    color: var(--text-dim);
    font-size: 19px;
}

/* ===== SKILL TAGS ===== */
.skils {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.skils h3 { width: 100%; margin-bottom: 10px; }

.skill-tag {
    font-size: 13px !important;
    padding: 8px 20px;
    border-radius: 50px;
    text-transform: uppercase;
    font-weight: 700;
    display: inline-block;
}

/* ===== PROGRESS BARS SECTION ===== */

.skill-wrapper {
    margin-bottom: 25px;
    width: 100%;
}

.skill-info {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
}

.skill-label {
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-main);
}

.skill-percentage {
    font-size: 17px;
    color: var(--accent);
    font-family: monospace;
}

/* ===== INTERACTIVE SKILL BUTTONS ===== */
.skill-info {
    display: flex;
    justify-content: space-between;
    align-items: center; /* Keeps button and percentage aligned */
    margin-bottom: 12px;
}

.skill-tags {
    font-size: 13px !important;
    padding: 8px 20px;
    border-radius: 50px;
    text-transform: uppercase;
    font-weight: 700;
    display: inline-block;
}

.skill-tags{
    /* Resetting default button styles */
    border: none;
    cursor: pointer;
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    gap: 10px;
    
    /* Shape and Padding */
    padding: 6px 18px;
    border-radius: 4px;
    
    /* Animation Properties */
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    overflow: hidden;
}

/* ===== GLASS REFLECTION EFFECT ===== */
.skill-tags {
    position: relative; /* Required to contain the reflection */
    overflow: hidden;    /* Hides the reflection when it's outside the button */
    /* ... keep your existing button styles (padding, border-radius, etc.) ... */
    border: 1px solid rgba(255, 255, 255, 0.1); /* Subtle glass edge */
    backdrop-filter: blur(5px); /* Blurs whatever is behind it slightly */
}





.skill-tag{
    /* Resetting default button styles */
    border: none;
    cursor: pointer;
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    gap: 10px;
    
    /* Shape and Padding */
    padding: 6px 18px;
    border-radius: 4px;
    
    /* Animation Properties */
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    overflow: hidden;
}

/* ===== GLASS REFLECTION EFFECT ===== */
.skill-tag {
    position: relative; /* Required to contain the reflection */
    overflow: hidden;    /* Hides the reflection when it's outside the button */
    /* ... keep your existing button styles (padding, border-radius, etc.) ... */
    border: 1px solid rgba(255, 255, 255, 0.1); /* Subtle glass edge */
    backdrop-filter: blur(5px); /* Blurs whatever is behind it slightly */
}

.skill-tag::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%; /* Start the reflection off-screen to the left */
    width: 50%;
    height: 100%;
    background: linear-gradient(
        to right, 
        rgba(255, 255, 255, 0) 0%, 
        rgba(255, 255, 255, 0.3) 50%, 
        rgba(255, 255, 255, 0) 100%
    );
    transform: skewX(-25deg); /* Tilts the light beam for a realistic look */
    transition: none; /* No transition by default */
}

/* When the user hovers, slide the reflection across */
.skill-tag:hover::before {
    left: 150%; /* Move it all the way to the right */
    transition: all 0.7s ease; /* Control the speed of the "flash" */
}

/* ===== HOVER POPUP EFFECT ===== */
.skill-tag:hover {
    transform: scale(1.1) translateY(-3px); /* Pops up and grows */
    filter: brightness(1.2); /* Makes it glow */
}

/* "Pressed" Effect when clicking */
.skill-tag:active {
    transform: scale(0.95) translateY(0);
}

/* Individual Color Glows (Matching your previous skill colors) */
.cpp:hover { box-shadow: 0 5px 15px rgba(0, 89, 156, 0.5); }
.c:hover   { box-shadow: 0 5px 15px rgba(168, 185, 204, 0.5); }
.html:hover { box-shadow: 0 5px 15px rgba(227, 79, 38, 0.5); }
.css:hover  { box-shadow: 0 5px 15px rgba(21, 114, 182, 0.5); }
.js:hover   { box-shadow: 0 5px 15px rgba(247, 223, 30, 0.4); }
.node:hover { box-shadow: 0 5px 15px rgba(51, 153, 51, 0.5); }
.express:hover { box-shadow: 0 5px 15px rgba(255, 255, 255, 0.2); }
.Drizzle:hover { box-shadow: 0 5px 15px rgba(230, 47, 47, 0.2); }

/* Ensuring Skill Percentage looks technical */
.skill-percentage {
    font-family: 'Courier New', monospace;
    font-weight: bold;
    color: var(--accent);
    background: rgba(255, 255, 255, 0.05);
    padding: 2px 8px;
    border-radius: 4px;
}

/* The outer track */
.progress-bar {
    width: 100%;
    height: 8px;
    background: #1a1a1a; /* Darker than the card */
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #333;
}

/* The moving part */
.progress {
    height: 100%;
    border-radius: 10px;
    width: 0; /* Starts at 0 for animation */
    animation: loadBars 2s cubic-bezier(0.1, 0.42, 0.41, 1) forwards;
    box-shadow: 0 0 10px rgba(0, 123, 255, 0.3); /* Subtle glow */
}

/* Specific Skill Colors & Levels */
.c-fill { background: #A8B9CC; width: 90% !important; }
.cpp-fill { background: #00599C; width: 90% !important; }
.node-fill { background: #339933; width: 80% !important; }
.html-fill { background: #E34F26; width: 95% !important; }
.javascript-fill { background: #F7DF1E; width: 90% !important; }
.exp-fill { background: #ffffff; width: 90% !important; }
.css-fill { background: #1572B6; width: 90% !important; }

/* Animation Logic */
@keyframes loadBars {
    from { width: 0; }
}

/* Individual Colors */
.cpp { background: #00599C; color: white; }
.c { background: #A8B9CC; color: #333; }
.html { background: #E34F26; color: white; }
.css { background: #1572B6; color: white; }
.js { background: #F7DF1E; color: black; }
.node { background: #339933; color: white; }
.express { background: #ffffff; color: black; }
.Drizzle { background: #e24242; color: black; }
.PostgreSQL { background: #8ecbdd; color: black; }
.Docker { background: #e43fc0; color: black; }
.Validators { background: #383b03; color: black; }
.LeafLet { background: #7cdf64; color: black; }
.Mongo { background: #05792b; color: black; }
/* ===== PROJECT CARDS ===== */

#descriptio{
    color: var(--text-dim);
    font-size: 19px;
    margin-top: 10px;
}

#project-name {
    color: var(--accent);
    font-size: 20px;
    margin-top: 40px;
}

/* .main-project img{
    width: 80%;
    height: auto;
} */

/* ===== CONTACT SECTION ===== */
.contact-section {
    background: #000;
    border-top: 1px solid #222;
}

.contact-section h3 {
    margin-bottom: 15px;
    font-weight: 300;
}

.contact-section span {
    font-weight: 600;
    color: var(--accent);
}

/* ===== ANIMATIONS ===== */
.animate {
    opacity: 0;
    animation: fadeUp 1s ease forwards;
}

@keyframes fadeUp {
    from {
        opacity: 0;
        transform: translateY(40px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ===== CONNECTIONS SECTION ===== */
.connecttions {
    grid-column: 2;
    padding: 20px 80px 60px 80px;
    background-color: var(--bg-dark);
    display: flex;
    gap: 30px;
    align-items: center;
    justify-content: center;
}

.connecttions img{
    width: 35px;
    height: 35px;
    object-fit: contain;
    cursor: pointer;
    
    /* FIX: This makes dark/black icons turn light gray so they are visible */
    filter: invert(1) opacity(0.5); 
    
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

/* ===== HOVER EFFECTS ===== */
.connecttions img:hover{
    /* FIX: Removes the inversion and opacity, showing original icon colors */
    filter: invert(0) opacity(1) drop-shadow(0 0 10px var(--accent));
    
    transform: scale(1.3) translateY(-8px);
}


/* Responsive adjustment for mobile */
@media (max-width: 900px) {
    .connecttions {
        grid-column: 1;
        justify-content: center;
        padding: 40px 25px;
    }
}

/* ===== RESPONSIVE ===== */
@media (max-width: 900px) {
    .container { grid-template-columns: 1fr; }
    .photo { position: relative; width: 100%; height: 50vh; }
    .user-card, .self-card, .contact-section {
        grid-column: 1;
        padding: 40px 25px;
    }
    .user-card { min-height: auto; }
}

/* ===== OTHER HOBBIES IMAGES (MARATHON) ===== */

.other-hobbies .main-project img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    border-radius: 12px;
    border: 1px solid #222;
    filter: grayscale(40%) brightness(0.85);
    transition: all 0.5s ease;
}

/* Image container grid */
.other-hobbies .main-project {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 25px;
}

/* Make text span full width */
.other-hobbies .main-project h3,
.other-hobbies .main-project p,
.other-hobbies .main-project a {
    grid-column: 1 / -1;
}

/* Hover animation */
.other-hobbies .main-project img:hover {
    filter: grayscale(0%) brightness(1);
    transform: scale(1.05);
    box-shadow: 0 15px 40px rgba(0, 123, 255, 0.25);
}

/* ===== IMAGE ENTRANCE ANIMATION ===== */
.other-hobbies .main-project img {
    opacity: 0;
    transform: translateY(30px);
    animation: imageFadeUp 1s ease forwards;
}

/* Stagger effect */
.other-hobbies .main-project img:nth-child(3) {
    animation-delay: 0.2s;
}
.other-hobbies .main-project img:nth-child(4) {
    animation-delay: 0.4s;
}

@keyframes imageFadeUp {
    from {
        opacity: 0;
        transform: translateY(40px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
